# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
#   cp .env.example .env
#   ./tools/dev/up.sh
#
# Every value here is read by the app as an ENVIRONMENT VARIABLE, which is why a
# teammate needs no `dotnet user-secrets` at all. The original machine uses
# user-secrets and both paths reach the same options — see docs/RUNNING.md.
#
# WHICH ONES ACTUALLY MATTER: the app boots with none of them. What it does
# instead is degrade honestly — each block below says what goes dark without it,
# so you can fill in only what you need rather than hunting six keys to see a
# sign-in screen.


# ---- Local infrastructure -------------------------------------------------
# Matches docker-compose.yml. Change only if you moved the ports.

MongoDbSettings__ConnectionString=mongodb://127.0.0.1:27017
MongoDbSettings__DatabaseName=LifeAdminAutopilotDB

# Identity/auth is SQL. SQLite locally so nobody installs SQL Server; the file is
# created on first run.
Database__Provider=Sqlite
ConnectionStrings__DefaultConnection=Data Source=./kitto-dev.db


# ---- Signing key ----------------------------------------------------------
# REQUIRED. Signs access tokens, and the Google OAuth state key is derived from
# it. Any long random string; it only has to be the same across restarts, or
# every existing session is invalidated.
#
#   openssl rand -hex 32
JWT_ACCESS_SECRET=


# ---- Google / Gemini ------------------------------------------------------
# Without it: /api/planning/propose and /me/knowledge/search answer 503, and
# every document scan fails. Chat still works — Langflow holds its own copy.
#
# One key covers planning, embeddings and document reading. Get it from
# https://aistudio.google.com/apikey
EMBEDDINGS_API_KEY=

# Optional overrides. Left blank they fall back to EMBEDDINGS_API_KEY above.
PLANNING_API_KEY=
DOCUMENT_AI_API_KEY=


# ---- Speech to text -------------------------------------------------------
# Without it: voice capture returns 503. A Hugging Face token with Inference
# Providers credit — https://huggingface.co/settings/tokens
#
# Credit is per ACCOUNT per month, not per token: minting a second token on an
# exhausted account changes nothing, which is the trap this line exists to warn
# about.
HF_TOKEN=


# ---- Google Calendar + Tasks ----------------------------------------------
# Without it: the integration reports available:false and refuses to connect,
# which is a correct state, not a failure.
#
# Google Cloud Console -> Clients -> Create client -> Web application.
# Register this exact redirect URI on the client:
#   http://localhost:4000/integrations/google/callback
#
# Enable BOTH the Google Calendar API and the Google Tasks API, and add each
# teammate's Google account under Audience -> Test users, or their consent is
# refused with access_denied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback

# Encrypts stored Google refresh tokens at rest. Exactly 64 hex characters.
# Changing it makes every existing connection undecryptable, so generate once:
#   openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=


# ---- Push notifications ---------------------------------------------------
# Without it: reminders still fire and still appear in the app; they just do not
# reach a phone.
#
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Save the .json OUTSIDE the repo and point at it here.
FCM_SERVICE_ACCOUNT_FILE=

# Deployed servers use this instead — the file's entire contents on one line.
FCM_SERVICE_ACCOUNT_JSON=


# ---- Chat agent -----------------------------------------------------------
# Matches docker-compose.yml. The flow id is the one in
# langflow/planning-agent.v4.json.
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=6b0f1c2e-9a41-4d3f-8c77-91a1f10a9e14

# The Planning Agent has NO ChatInput node, so input_value alone reaches
# nothing: Langflow accepts the run, streams a healthy-looking turn, and hands
# the agent an empty prompt with no error anywhere.
LANGFLOW_INPUT_NODE=PlanningInput-v4

# How the flow's eleven tools reach BACK into Kitto, written into Langflow by
# tools/dev/langflow-import.sh. host.docker.internal, never localhost: inside
# that container localhost is Langflow itself.
#
# Change it only if the backend is not on 4000. Getting it wrong fails a long
# way from the cause — Langflow answers 500 while building an unrelated tool and
# blames fifteen "outdated components".
STEWARD_API_BASE_URL=http://host.docker.internal:4000


# ---- Where the frontend runs ----------------------------------------------
# The browser origin is checked. Add a LAN address if you open the app from a
# phone on the same Wi-Fi.
Kernel__Cors__Origins=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost

# Background workers: reminders, Google sync, document scans, the calendar push.
Kernel__Workers__Enabled=true

# Bind on ALL interfaces, not loopback. Langflow's tools call in from inside a
# container via host.docker.internal, which cannot reach a listener bound to
# 127.0.0.1 — chat then answers but every tool fails. up.sh defaults to this;
# it is spelled out because overriding it to 127.0.0.1 looks harmless.
ASPNETCORE_URLS=http://[::]:4000

# Browser/webview origins allowed by CORS. Leave it unset and up.sh fills in the
# local dev set (localhost:3000, capacitor://localhost). Set it here only to
# override that entirely.
#
# Worth knowing because the failure is silent: the allowlist defaults to EMPTY,
# and a request with NO Origin header is allowed — so curl and /health look
# healthy while every call from the browser or the phone is refused.
#
# A phone on the LAN needs its own origin too (http://<your-LAN-IP>:3000). The
# frontend's `npm run app` passes that automatically via EXTRA_CORS_ORIGINS, so
# you should not need to add it by hand.
# Kernel__Cors__Origins=http://localhost:3000,capacitor://localhost
