<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Life_Admin_Autopilot_Backend-320a3928-75dd-43e1-baad-8fdb9c597e61</UserSecretsId>
    <RootNamespace>Life_Admin_Autopilot_Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive via Microsoft.AspNetCore.OpenApi 10.0.10, which still resolves
         Microsoft.OpenApi 2.0.0 - NU1903 / GHSA-v5pm-xwqc-g5wc (high). No newer
         10.0.x framework package exists, so the transitive is pinned directly to
         the first patched release. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Life-Admin-Autopilot.BLL\Life-Admin-Autopilot.BLL.csproj" />
    <ProjectReference Include="..\Life-Admin-Autopilot.DAL\Life-Admin-Autopilot.DAL.csproj" />
  </ItemGroup>

</Project>
