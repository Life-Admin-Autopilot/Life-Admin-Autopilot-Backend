        "clarification_delta": 0,
        "max_tool_rounds": 1,
        "all_tool_calls_resolved": true
      },
      "outcome": {
        "reply_non_empty": true,
        "no_question_in_prose": { "max_with_hold": 0, "max_without_hold": 0 }
      }
    }
